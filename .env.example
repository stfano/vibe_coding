# Copy this file to .env before running Docker Compose.

# Django
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVICE_VERSION=0.1.0

# Backend / frontend ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Database
# Use the Supabase Postgres connection string for deployed or shared environments.
# Leave empty for local SQLite fallback during early development.
DATABASE_URL=
# Example: postgresql://postgres:change-me@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=
DATABASE_CONN_MAX_AGE=60

# Supabase project metadata
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# External Q&A ingestion
INGESTION_WORKERS=5
INGESTION_LOG_FILE=ingestion.log
HIDOC_REQUEST_DELAY=0.5
HIDOC_TIMEOUT=15
HIDOC_RETRIES=3
HIDOC_USER_AGENT=DoctorChatQnaIngestion/0.1

# Redis
REDIS_URL=redis://redis:6379/0

# Vector retrieval
# MVP vector retrieval uses Supabase/Postgres pgvector. SQLite fallback can run
# non-RAG tests and APIs, but cannot execute vector search.
VECTOR_STORE_BACKEND=pgvector
VECTOR_DIMENSIONS=1024
VECTOR_DISTANCE_METRIC=cosine
VECTOR_SIMILARITY_THRESHOLD=0.7
CHAT_RAG_LOW_CONFIDENCE_THRESHOLD=0.05

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=doctor_chat_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=doctor-chat-documents

# Embedding/reranker scaffold
EMBEDDING_PROVIDER=deterministic
EMBEDDING_SERVICE_URL=http://embedding-service:8080
EMBEDDING_TIMEOUT=15
INDEXING_CHUNK_CHARS=1200
INDEXING_LOG_FILE=ingestion.log
EMBEDDING_MODEL=mykor/KURE-v1
RERANKER_MODEL=BAAI/bge-reranker-base

# Optional local LLM runtime. Start with: docker compose --profile llm up ollama
OLLAMA_BASE_URL=http://ollama:11434
CHAT_LLM_PROVIDER=ollama
CHAT_LLM_MODEL=llama3.1:8b
CHAT_LLM_TIMEOUT=30


# Optional local tooling keys. Keep real values only in untracked local env files.
CONTEXT7_MCP_SERVER_KEY=
GITHUB_TOKEN=
