# Copy this file to .env before running Docker Compose.

# Django
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVICE_VERSION=0.1.0

# Backend / frontend ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Database
# Use the Supabase Postgres connection string for deployed or shared environments.
# Leave empty for local SQLite fallback during early development.
DATABASE_URL=
# Example: postgresql://postgres:change-me@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=
DATABASE_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=doctor_chat_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=doctor-chat-documents

# Embedding/reranker scaffold
EMBEDDING_SERVICE_URL=http://embedding-service:8080
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Optional local LLM runtime. Start with: docker compose --profile llm up ollama
OLLAMA_BASE_URL=http://ollama:11434


# Optional local tooling keys. Keep real values only in untracked local env files.
CONTEXT7_MCP_SERVER_KEY=
GITHUB_TOKEN=
